{
  "nodeModulesDir": "auto",
  "deploy": {
    "install": "deno install",
    "build": "npm run build",
    "runtime": {
      "type": "static",
      "cwd": "./dist"
    }
  },
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "semiColons": false,
    "singleQuote": true
  }
}
